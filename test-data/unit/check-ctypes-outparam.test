[case testCtypesOutparamConcreteOverrideResults]
from ctypes import Structure, c_int, c_wchar_p

class Text(c_wchar_p):
    def __ctypes_from_outparam__(self) -> str | None:
        return self.value

class NumberText(c_int):
    def __ctypes_from_outparam__(self) -> str:
        return "converted"

class Data(Structure):
    def __ctypes_from_outparam__(self) -> dict[str, str]:
        return {"kind": "structure"}

reveal_type(Text("text").__ctypes_from_outparam__())  # N: Revealed type is "builtins.str | None"
reveal_type(NumberText(17).__ctypes_from_outparam__())  # N: Revealed type is "builtins.str"
reveal_type(Data().__ctypes_from_outparam__())  # N: Revealed type is "builtins.dict[builtins.str, builtins.str]"
[builtins fixtures/floatdict.pyi]
[typing fixtures/typing-medium.pyi]

[case testCtypesOutparamOptionalArguments]
from ctypes import c_int

class Positional(c_int):
    def __ctypes_from_outparam__(self, value: int = 1) -> str:
        return "converted"

class Keyword(c_int):
    def __ctypes_from_outparam__(self, *, value: int = 1) -> str:
        return "converted"

class PositionalOnly(c_int):
    def __ctypes_from_outparam__(self, value: int = 1, /) -> str:
        return "converted"

class Variadic(c_int):
    def __ctypes_from_outparam__(self, *args: object, **kwargs: object) -> str:
        return "converted"

reveal_type(Positional().__ctypes_from_outparam__())  # N: Revealed type is "builtins.str"
reveal_type(Keyword().__ctypes_from_outparam__())  # N: Revealed type is "builtins.str"
reveal_type(PositionalOnly().__ctypes_from_outparam__())  # N: Revealed type is "builtins.str"
reveal_type(Variadic().__ctypes_from_outparam__())  # N: Revealed type is "builtins.str"
[builtins fixtures/floatdict.pyi]
[typing fixtures/typing-medium.pyi]

[case testCtypesOutparamHonestBasePrecision]
from ctypes import Structure, c_int, c_wchar_p

class Number(c_int):
    pass

reveal_type(c_int(17).__ctypes_from_outparam__())  # N: Revealed type is "builtins.object"
reveal_type(c_wchar_p("text").__ctypes_from_outparam__())  # N: Revealed type is "builtins.object"
reveal_type(Number(17).__ctypes_from_outparam__())  # N: Revealed type is "builtins.object"
reveal_type(Structure().__ctypes_from_outparam__())  # N: Revealed type is "builtins.object"
reveal_type(Number(17).value)  # N: Revealed type is "builtins.int"
reveal_type(c_wchar_p("text").value)  # N: Revealed type is "builtins.str | None"
[builtins fixtures/floatdict.pyi]
[typing fixtures/typing-medium.pyi]

