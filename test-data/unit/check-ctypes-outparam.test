[case testCtypesOutparamReturnValueAndConsumerErrors]
from ctypes import c_int

class BadBody(c_int):
    def __ctypes_from_outparam__(self) -> str:
        return 17  # E: Incompatible return value type (got "int", expected "str")

class Text(c_int):
    def __ctypes_from_outparam__(self) -> str:
        return "converted"

number: int = Text(17).__ctypes_from_outparam__()  # E: Incompatible types in assignment (expression has type "str", variable has type "int")
Text(17).value = "bad"  # E: Incompatible types in assignment (expression has type "str", variable has type "int")
unknown = c_int(17).__ctypes_from_outparam__()
number = unknown  # E: Incompatible types in assignment (expression has type "object", variable has type "int")
unknown.arbitrary_member  # E: "object" has no attribute "arbitrary_member"
unknown + 1  # E: Unsupported left operand type for + ("object")
[builtins fixtures/floatdict.pyi]
[typing fixtures/typing-medium.pyi]

[case testCtypesOutparamConstructorsRetainValueType]
from ctypes import c_int, c_wchar_p

c_int(17)
c_wchar_p("text")
c_wchar_p(None)
c_int("bad")  # E: Argument 1 to "c_int" has incompatible type "str"; expected "int"
c_wchar_p(17)  # Native pointer-address constructor remains valid.
[builtins fixtures/floatdict.pyi]
[typing fixtures/typing-medium.pyi]
