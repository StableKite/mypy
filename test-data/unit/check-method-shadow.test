class Class(Base):  # E: Override of "call" must preserve the inherited writable instance callable contract from "Base"
    @classmethod
    def call(cls, value: int) -> int: return value
class Final(Base):  # E: Override of "call" must preserve the inherited writable instance callable contract from "Base"
    @final
    def call(self, value: int) -> int: return value
class Property(Base):  # E: Override of "call" must preserve the inherited writable instance callable contract from "Base"
    @property
    def call(self) -> Callable[[int], int]: return self.initial
