[case testMethodShadowUnchangedReadonlyCases]
from typing import Callable, final
class Dispatch:
    def initial(self, value: int) -> int: return value
    def ordinary(self, value: int) -> int: return value
    @final
    def final(self, value: int) -> int: return value
    @staticmethod
    def static(value: int) -> int: return value
    @classmethod
    def clsmethod(cls, value: int) -> int: return value
    def __init__(self) -> None:
        self.ordinary = self.initial  # E: Cannot assign to a method
        self.final: Callable[[int], int] = self.initial  # E: Cannot assign to final attribute "final" \
            # E: Cannot assign to a method
        self.static: Callable[[int], int] = self.initial  # E: Cannot assign to a method
        self.clsmethod: Callable[[int], int] = self.initial  # E: Cannot assign to a method
[builtins fixtures/classmethod.pyi]

