[case testMethodShadowAliasCannotNarrowKeywordContract]
from typing import Callable
class Dispatch:
    def initial(self, value: int) -> int: return value
    def other(self, other: int) -> int: return other
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
def use(instance: Dispatch) -> int:
    instance.call = instance.initial
    alias = instance
    alias.call = instance.other
    return instance.call(value=1)  # E: Unexpected keyword argument "value"

[case testMethodShadowAliasCannotNarrowResultContract]
from typing import Callable
class Dispatch:
    def initial(self) -> int: return 1
    def boolean(self) -> bool: return True
    def call(self) -> int: return 1
    def __init__(self) -> None:
        self.call: Callable[[], int] = self.initial
def use(instance: Dispatch) -> bool:
    instance.call = instance.boolean
    alias = instance
    alias.call = instance.initial
    return instance.call()  # E: Incompatible return value type (got "int", expected "bool")
