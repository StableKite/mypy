-- An explicit instance callable contract keeps the original class function.

[case testMethodShadowExplicitAndBare]
from typing import Callable
class Explicit:
    def initial(self, value: int) -> int: return value
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
class Bare:
    def __init__(self) -> None:
        self.call: Callable[[int], int]
        self.call = self.initial
        self.normal: Callable[[int], int] = self.initial
    def initial(self, value: int) -> int: return value
    def call(self, value: int) -> int: return value
def use(first: Explicit, second: Bare) -> None:
    result: int = first.call(1)
    result = Explicit.call(first, value=1)
    result = second.call(1)
    result = Bare.call(second, value=1)
    result = second.normal(1)

[case testMethodShadowSeparateKeywordAndProtocolViews]
from typing import Callable, Protocol
class Dispatch:
    def initial(self, other: int) -> int: return other
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
class Named(Protocol):
    def call(self, value: int) -> int: ...
class Positional(Protocol):
    def call(self, value: int, /) -> int: ...
def use(instance: Dispatch) -> None:
    result: int = Dispatch.call(instance, value=1)
    result = instance.call(1)
    instance.call(value=1)  # E: Unexpected keyword argument "value"
    named: Named = instance  # E: Incompatible types in assignment (expression has type "Dispatch", variable has type "Named")
    positional: Positional = instance

[case testMethodShadowSuperAndOperatorBypass]
from typing import Callable
class Base:
    def initial(self, other: int) -> int: return other
    def call(self, value: int) -> int: return value
    def __call__(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
        self.__call__: Callable[[int], int] = self.initial
class Child(Base):
    def invoke(self) -> int:
        return super().call(value=1)
def use(instance: Base) -> None:
    result: int = instance(value=1)
    result = Base.__call__(instance, value=1)
    instance.__call__(value=1)  # E: Unexpected keyword argument "value"

[case testMethodShadowWritableOverrideInvariant]
from typing import Callable
class Base:
    def initial(self, value: int) -> int: return value
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
class Narrow(Base):  # E: Override of "call" must preserve the inherited writable instance callable contract from "Base"
    def call(self, value: int) -> bool: return True
class Wide(Base):  # E: Override of "call" must preserve the inherited writable instance callable contract from "Base"
    def call(self, value: object) -> int: return 1
class Same(Base):
    def call(self, value: int) -> int: return value
