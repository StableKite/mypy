[case testMethodShadowInferredVariance]
# flags: --python-version 3.12
from typing import Callable
class Source[T]:
    def __init__(self, value: T) -> None:
        self._value = value
        self.call: Callable[[], T] = self.initial
    def initial(self) -> T: return self._value
    def call(self) -> T: return self._value
def use(strings: Source[str]) -> None:
    objects: Source[object] = strings  # E: Incompatible types in assignment (expression has type "Source[str]", variable has type "Source[object]")

[case testMethodShadowExplicitVariance]
from typing import Callable, Generic, TypeVar
T = TypeVar('T', covariant=True)
class Source(Generic[T]):
    def __init__(self, value: T) -> None:
        self._value = value
        self.call: Callable[[], T] = self.initial  # E: Cannot assign to a method \
            # E: Explicit instance callable contract must match the bound method and inherited writable contract
    def initial(self) -> T: return self._value
    def call(self) -> T: return self._value

[case testMethodShadowInvalidWritesRemainErrors]
from typing import Callable
class Dispatch:
    def initial(self, value: int) -> int: return value
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callable[[int], int] = self.initial
def free(value: int) -> int: return value
def use(instance: Dispatch) -> None:
    instance.call = free  # E: Cannot assign to a method
    instance.call = lambda value: value  # E: Cannot assign to a method
    instance.call = Dispatch.initial  # E: Cannot assign to a method \
        # E: Incompatible types in assignment (expression has type "Callable[[Dispatch, int], int]", variable has type "Callable[[int], int]")
    Dispatch.call = Dispatch.initial  # E: Cannot assign to a method
    del instance.call  # E: Cannot assign to a method

[case testMethodShadowCallbackNames]
from typing import Protocol
class Callback(Protocol):
    def __call__(self, value: int) -> int: ...
class Dispatch:
    def initial(self, value: int) -> int: return value
    def call(self, value: int) -> int: return value
    def __init__(self) -> None:
        self.call: Callback = self.initial
def use(instance: Dispatch) -> int:
    return instance.call(value=1) + Dispatch.call(instance, value=1)

